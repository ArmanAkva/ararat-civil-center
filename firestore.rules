rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'akvadevlead@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (getUserData().role == 'admin' || getUserData().role == 'super-admin'))
      );
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'akvadevlead@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().role == 'super-admin')
      );
    }

    // Users Collection & Profiles
    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isSuperAdmin();
    }

    // Civilizations Hubs Content & Subcollections
    match /civilizations/{civId} {
      allow read: if true;
      allow write: if isAdmin();

      // Subcollection: Think Tanks / Centers
      match /centers/{centerId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      // Subcollection: Thinkers / Authors
      match /authors/{authorId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      // Subcollection: Publications / Works
      match /publications/{pubId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Collection Group queries across all civilizations
    match /{path=**}/centers/{centerId} {
      allow read: if true;
    }
    match /{path=**}/authors/{authorId} {
      allow read: if true;
    }
    match /{path=**}/publications/{pubId} {
      allow read: if true;
    }

    // Site Pages Content (home, about, dialogue, forum)
    match /site_content/{pageKey} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Dialogues & Comments Subcollection (dialogues/{dialogueId}/comments/{commentId})
    match /dialogues/{dialogueId} {
      allow read: if true;
      allow create: if isAdmin() || (request.resource.data.status == 'pending');
      allow update, delete: if isAdmin();

      // Comments Subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if isAdmin() || (isAuthenticated() && resource != null && request.auth.uid == resource.data.authorUid);
      }
    }

    // Collection Group queries across all dialogues' comments
    match /{path=**}/comments/{commentId} {
      allow read: if true;
    }

    // Legacy Dialogue Topics (compatibility)
    match /dialogue_topics/{topicId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if isAdmin() || (isAuthenticated() && resource != null && request.auth.uid == resource.data.authorUid);
      }
    }

    // Legacy Public Feedback & Dialogue Comments (compatibility)
    match /dialogue_comments/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin() || (isAuthenticated() && resource != null && request.auth.uid == resource.data.authorUid);
    }

    // Forum Public Suggestions, Proposals & Comments
    match /forum_suggestions/{suggestionId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin() || (isAuthenticated() && resource != null && request.auth.uid == resource.data.authorUid);
    }

    // Notifications
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if true;
      allow update, delete: if isAuthenticated() && (resource != null && (resource.data.userId == request.auth.uid || isAdmin()));
    }
  }
}
