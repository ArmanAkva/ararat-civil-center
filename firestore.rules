rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'akvadevlead@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (getUserData().role == 'admin' || getUserData().role == 'super-admin'))
      );
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'akvadevlead@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().role == 'super-admin')
      );
    }

    // Users Collection & Profiles
    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isSuperAdmin();
    }

    // Civilizations Hubs Content & Subcollections
    match /civilizations/{civId} {
      allow read: if true;
      allow write: if isAdmin();

      // Subcollection: Think Tanks / Centers
      match /centers/{centerId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      // Subcollection: Thinkers / Authors
      match /authors/{authorId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      // Subcollection: Publications / Works
      match /publications/{pubId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Collection Group queries across all civilizations
    match /{path=**}/centers/{centerId} {
      allow read: if true;
    }
    match /{path=**}/authors/{authorId} {
      allow read: if true;
    }
    match /{path=**}/publications/{pubId} {
      allow read: if true;
    }

    // Site Pages Content (home, about, dialogue, forum)
    match /site_content/{pageKey} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public Feedback & Dialogue Comments
    match /dialogue_comments/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }
  }
}
